@startuml inicio_programa
!theme plain
skinparam backgroundColor #FEFEFE
skinparam activityBackgroundColor #E3F2FD
skinparam activityBorderColor #1565C0
skinparam activityDiamondBackgroundColor #FFF3E0
skinparam activityDiamondBorderColor #E65100
skinparam arrowColor #333333
skinparam defaultFontName Inter

title Diagrama de Flujo: Inicio del Programa

start

:Configurar logging
(stdout + archivo .log);

:Crear instancias:
- ComunicacionSerie(VID, PID)
- CamaraUSB()
- GestorEnsayo();

:Crear AppPrincipal
(inyección de dependencias);

:Construir interfaz gráfica
(construir_ui);

:Interceptar logs WARNING
para panel de Advertencias;

partition "Inicializar Hardware" {
    :Listar cámaras disponibles
    (probar índices 0..4);

    if (¿Hay cámaras?) then (sí)
        :Poblar ComboBox cámaras;
        :Conectar a la primera cámara;
    else (no)
        :Mostrar "Ninguna" en ComboBox;
    endif

    :Listar puertos COM disponibles;

    if (¿Hay puertos COM?) then (sí)
        :Autodetectar puerto
        por VID/PID;

        if (¿Puerto encontrado?) then (sí)
            :Seleccionar puerto
            autodetectado en ComboBox;
        else (no)
            :Seleccionar primer
            puerto disponible;
        endif

        :Conectar al puerto seleccionado
        (115200, 8N1, DTR/RTS off);
    else (no)
        :Mostrar "Ninguno" en ComboBox;
    endif
}

:Iniciar monitoreo periódico
de estado de conexión (cada 500 ms);

:Iniciar mainloop (UI);

stop

@enduml
